@page "/change-password"
@layout EmptyLayout
@inject AuthService Auth
@inject AuthSession Session
@inject NavigationManager Nav

<PageTitle>Mot de passe · e-Campus</PageTitle>

<div class="d-flex min-vh-100 align-items-center justify-content-center bg-light p-3">
    <div class="card shadow-sm w-100" style="max-width: 380px">
        <div class="card-body p-4">
            <h1 class="h3">Changer mon mot de passe</h1>
            <p class="text-muted small">
                @(first ? "Première connexion : choisissez votre propre mot de passe pour continuer." : "Choisissez un nouveau mot de passe.")
            </p>

            <EditForm Model="form" OnValidSubmit="SubmitAsync">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label for="current" class="form-label">@(first ? "Mot de passe reçu par email" : "Mot de passe actuel")</label>
                    <InputText id="current" type="password" class="form-control" @bind-Value="form.CurrentPassword"
                               autocomplete="current-password" />
                    <ValidationMessage For="() => form.CurrentPassword" class="text-danger small" />
                </div>
                <div class="mb-3">
                    <label for="new" class="form-label">Nouveau mot de passe</label>
                    <InputText id="new" type="password" class="form-control" @bind-Value="form.NewPassword"
                               autocomplete="new-password" />
                    <ValidationMessage For="() => form.NewPassword" class="text-danger small" />
                </div>
                <div class="mb-3">
                    <label for="confirm" class="form-label">Confirmer le nouveau mot de passe</label>
                    <InputText id="confirm" type="password" class="form-control" @bind-Value="form.ConfirmPassword"
                               autocomplete="new-password" />
                    <ValidationMessage For="() => form.ConfirmPassword" class="text-danger small" />
                </div>

                @if (error is not null)
                {
                    <div class="alert alert-danger py-2" role="alert">@error</div>
                }

                <button type="submit" class="btn btn-primary w-100" disabled="@busy">
                    @(busy ? "Enregistrement…" : "Enregistrer")
                </button>
            </EditForm>

            <button type="button" class="btn btn-link btn-sm w-100 mt-2" @onclick="LeaveAsync">
                @(first ? "Se déconnecter" : "← Retour à l'accueil")
            </button>
        </div>
    </div>
</div>

@code {
    private readonly ChangePasswordForm form = new();
    private bool busy;
    private bool first;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        await Auth.EnsureRestoredAsync();
        if (!Session.IsAuthenticated)
        {
            Nav.NavigateTo("login", replace: true);
            return;
        }
        first = Session.User!.MustChangePassword;
    }

    private async Task SubmitAsync()
    {
        busy = true;
        error = null;
        try
        {
            await Auth.ChangePasswordAsync(form);
            Nav.NavigateTo("", replace: true);
        }
        catch (ApiException e)
        {
            if (e.Status == HttpStatusCode.Unauthorized)
            {
                await Auth.LogoutAsync();
                Nav.NavigateTo("login", replace: true);
                return;
            }
            error = e.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task LeaveAsync()
    {
        if (first)
        {
            await Auth.LogoutAsync();
            Nav.NavigateTo("login", replace: true);
        }
        else
        {
            Nav.NavigateTo("", replace: true);
        }
    }
}