@page "/"
@layout EmptyLayout
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@inject AuthService Auth
@inject AuthSession Session
@inject NavigationManager Nav

<PageTitle>Accueil · e-Campus</PageTitle>

<div class="flex min-h-screen flex-col bg-slate-50 text-slate-900">

    @* ===== Barre du haut ===== *@
    <header class="sticky top-0 z-10 border-b border-slate-200 bg-white/90 backdrop-blur">
        <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
            <a href="" class="flex items-center gap-3 font-bold text-slate-900">
                <span class="grid h-9 w-9 place-items-center rounded-lg bg-purple-700 text-sm text-white">eC</span>
                <span class="text-lg">e-Campus</span>
            </a>

            <a href="login"
               class="rounded-full bg-linear-to-r from-purple-700 to-fuchsia-600 px-6 py-2 text-sm font-semibold text-white shadow-md shadow-purple-500/30 transition hover:brightness-110 focus:outline-none focus:ring-4 focus:ring-purple-200">
                Se connecter
            </a>
        </div>
    </header>
</div>

@* ===== Bandeau principal ===== *@
    

@code {
    protected override async Task OnInitializedAsync()
    {
        // Déjà connecté : on va directement au tableau de bord
        await Auth.EnsureRestoredAsync();
        if (Session.IsAuthenticated)
        {
            Nav.NavigateTo(Session.User!.MustChangePassword ? "change-password" : "dashboard", replace: true);
        }
    }
}