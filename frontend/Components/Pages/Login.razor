@page "/login"
@layout EmptyLayout
@inject AuthService Auth
@inject AuthSession Session
@inject NavigationManager Nav

<PageTitle>Connexion · e-Campus</PageTitle>

<div
    class="flex min-h-screen items-center justify-center bg-linear-to-br p-4">

    <div
        class="flex w-full max-w-4xl min-h-135 overflow-hidden rounded-2xl bg-white shadow-2xl shadow-purple-950/40">

            <section class="flex w-full flex-col justify-center px-8 py-10 sm:px-14 lg:w-1/2">

            <h1 class="mb-8 text-center text-3xl font-bold uppercase tracking-wide text-slate-900">Connexion</h1>

            <EditForm Model="form" OnValidSubmit="SubmitAsync" class="space-y-5">
                <DataAnnotationsValidator />

                <div>
                    <div class="relative">
                        <InputText id="email"
                                   class="peer block w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-slate-900 placeholder-transparent outline-none transition focus:border-purple-700"
                                   placeholder=" " @bind-Value="form.Email" autocomplete="username" />
                        <label for="email"
                               class="pointer-events-none absolute left-3 -top-2.5 bg-white px-1 text-xs font-semibold text-purple-700 transition-all peer-placeholder-shown:top-3.5 peer-placeholder-shown:text-base peer-placeholder-shown:font-normal peer-placeholder-shown:text-slate-400 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:font-semibold peer-focus:text-purple-700">
                            Email
                        </label>
                    </div>
                    <ValidationMessage For="() => form.Email" class="mt-1 block text-sm text-red-600" />
                </div>

                <div>
                    <div class="relative">
                        <InputText id="password" type="@(showPassword ? "text" : "password")"
                                   class="peer block w-full rounded-lg border border-slate-300 bg-white py-3 pl-4 pr-12 text-slate-900 placeholder-transparent outline-none transition focus:border-purple-700"
                                   placeholder=" " @bind-Value="form.Password" autocomplete="current-password" />
                        <label for="password"
                               class="pointer-events-none absolute left-3 -top-2.5 bg-white px-1 text-xs font-semibold text-purple-700 transition-all peer-placeholder-shown:top-3.5 peer-placeholder-shown:text-base peer-placeholder-shown:font-normal peer-placeholder-shown:text-slate-400 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:font-semibold peer-focus:text-purple-700">
                            Mot de passe
                        </label>

                        <button type="button"
                                class="absolute inset-y-0 right-0 flex items-center px-4 text-slate-400 transition hover:text-purple-700"
                                aria-label="@(showPassword ? "Masquer le mot de passe" : "Afficher le mot de passe")"
                                @onclick="() => showPassword = !showPassword">
                            @if (showPassword)
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24"
                                     stroke="currentColor" stroke-width="1.8">
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                          d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />
                                </svg>
                            }
                            else
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24"
                                     stroke="currentColor" stroke-width="1.8">
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                          d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                          d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                </svg>
                            }
                        </button>
                    </div>
                    <ValidationMessage For="() => form.Password" class="mt-1 block text-sm text-red-600" />
                </div>

                @if (error is not null)
                {
                    <div class="flex items-start gap-2 rounded-lg bg-red-50 px-3.5 py-3 text-sm text-red-700 ring-1 ring-red-200"
                         role="alert">
                        <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 h-4 w-4 shrink-0" viewBox="0 0 20 20"
                             fill="currentColor">
                            <path fill-rule="evenodd"
                                  d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-4a1 1 0 00-1 1v3a1 1 0 002 0V7a1 1 0 00-1-1zm0 8a1 1 0 100-2 1 1 0 000 2z"
                                  clip-rule="evenodd" />
                        </svg>
                        <span>@error</span>
                    </div>
                }

                <div class="pt-2 text-center">
                    <button type="submit" disabled="@busy"
                            class="inline-flex min-w-40 items-center justify-center gap-2 rounded-full bg-linear-to-r from-purple-700 to-fuchsia-600 px-10 py-2.5 text-sm font-semibold text-white shadow-lg shadow-purple-500/30 transition hover:brightness-110 focus:outline-none focus:ring-4 focus:ring-purple-200 disabled:cursor-not-allowed disabled:opacity-70">
                        @if (busy)
                        {
                            <svg class="h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4">
                                </circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
                            </svg>
                            <span>Connexion…</span>
                        }
                        else
                        {
                            <span>Se connecter</span>
                        }
                    </button>
                </div>

             
            </EditForm>
        </section>

        <aside
            class="hidden w-1/2 flex-col items-center justify-center bg-linear-to-br from-purple-800 to-fuchsia-600 px-12 text-center text-white lg:flex lg:rounded-l-[150px]">
            <h2 class="text-4xl font-bold uppercase tracking-wide">Bienvenue !</h2>
            <p class="mt-4 max-w-xs text-sm leading-relaxed text-purple-100">
                Connectez-vous avec vos identifiants pour accéder à toutes les fonctionnalités de votre espace e-Campus.
            </p>
            <span
                class="mt-6 rounded-full border border-white px-10 py-2 text-sm font-semibold uppercase tracking-wide">
                e-Campus
            </span>
        </aside>
    </div>
</div>

@code {
    private readonly LoginForm form = new();
    private bool busy;
    private bool showPassword;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        // Déjà connecté : inutile de revoir le formulaire
        await Auth.EnsureRestoredAsync();
        if (Session.IsAuthenticated) NavigateAfterLogin();
    }

    private async Task SubmitAsync()
    {
        busy = true;
        error = null;
        try
        {
            await Auth.LoginAsync(form);
            NavigateAfterLogin();
        }
        catch (ApiException e)
        {
            error = e.Status == HttpStatusCode.Unauthorized ? "Email ou mot de passe incorrect." : e.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private void NavigateAfterLogin()
    {
        Nav.NavigateTo(Session.User!.MustChangePassword ? "change-password" : "dashboard", replace: true);
    }
}