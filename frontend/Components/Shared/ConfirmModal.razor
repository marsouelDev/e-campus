@if (Show)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Title</h5>
                </div>
                <div class="modal-body">@ChildContent</div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="() => OnCancel.InvokeAsync()" disabled="@Busy">Annuler</button>
                    <button type="button" class="btn @ConfirmClass" @onclick="() => OnConfirm.InvokeAsync()" disabled="@Busy">
                        @(Busy ? "Patientez…" : ConfirmText)
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public string Title { get; set; } = "Confirmation";
    [Parameter] public string ConfirmText { get; set; } = "Confirmer";
    [Parameter] public string ConfirmClass { get; set; } = "btn-danger";
    [Parameter] public bool Busy { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
}